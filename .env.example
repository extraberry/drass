# DRASS settings. Copy to .env and edit. (setup.ps1 does the copy for you.)
APP_NAME=DRASS
API_HOST=0.0.0.0
API_PORT=8000
ENABLE_DOCS=false

# ---- campus database (main) ----
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=drass
MYSQL_USER=drass_user
MYSQL_PASSWORD=change-me
# DATABASE_URL=mysql+pymysql://user:pass@host:3306/drass?charset=utf8mb4   (optional: overrides the MYSQL_* values)

FILE_STORAGE_ROOT=./storage
EMBEDDING_MODEL_PATH=./models/sentence-transformer-model
BACKUP_DIR=./backups
