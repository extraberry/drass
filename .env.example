APP_NAME=DRASS

API_HOST=0.0.0.0
API_PORT=8000
ENABLE_DOCS=true            # set false in production

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=drass
MYSQL_USER=drass_user
MYSQL_PASSWORD=test123

FILE_STORAGE_ROOT=./storage
EMBEDDING_MODEL_PATH=./models/sentence-transformer-model
BACKUP_DIR=./backups

# Client: address of the DRASS server on your LAN
DRASS_SERVER_URL=http://127.0.0.1:8000

# Defaults below are stored in the database (system_settings) and editable by ADMIN:
# SEMANTIC_THRESHOLD=0.35  RECOMMENDATION_COUNT=5  SESSION_IDLE_TIMEOUT_MINUTES=20
# FAILED_LOGIN_LIMIT=5     LOCKOUT_MINUTES=15      MAX_MANUSCRIPT_MB=100  MAX_COMPANION_MB=500
